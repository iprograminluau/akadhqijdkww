-- ---------- recently-visited servers (survives a hop) ----------
-- The Lua VM dies on every teleport, so "which servers did I just come from" has to
-- live on disk. Without this the bot happily bounces A -> B -> A.
local RECENT_FILE = "wishub_gag2_recent.json"
local RECENT_MAX = 25
local RECENT_TTL = 900

local hasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local recentCache = nil

local function loadRecent()
    if recentCache then return recentCache end
    recentCache = {}
    if hasFS then
        pcall(function()
            if isfile(RECENT_FILE) then
                local d = HttpService:JSONDecode(readfile(RECENT_FILE))
                if type(d) == "table" then recentCache = d end
            end
        end)
    elseif type(getgenv) == "function" then
        local g = getgenv()
        g.__WISHUB_RECENT = g.__WISHUB_RECENT or {}
        recentCache = g.__WISHUB_RECENT
    end
    local now = os.time()
    for job, ts in pairs(recentCache) do
        if type(ts) ~= "number" or now - ts > RECENT_TTL then recentCache[job] = nil end
    end
    return recentCache
end

local function saveRecent()
    local t = loadRecent()
    local list = {}
    for job, ts in pairs(t) do list[#list + 1] = { job = job, ts = ts } end
    if #list > RECENT_MAX then
        table.sort(list, function(a, b) return a.ts > b.ts end)
        for i = RECENT_MAX + 1, #list do t[list[i].job] = nil end
    end
    if hasFS then
        pcall(function() writefile(RECENT_FILE, HttpService:JSONEncode(t)) end)
    end
end

local function normJob(job)
    return string.lower(tostring(job or ""))
end

local function markVisited(job)
    job = normJob(job)
    if job == "" then return end
    loadRecent()[job] = os.time()
    saveRecent()
end

local function wasRecent(job)
    return loadRecent()[normJob(job)] ~= nil
end

