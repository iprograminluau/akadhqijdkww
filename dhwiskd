end

local firedPrompts = {}

local function promptPresent(p)
    return p ~= nil and p.Parent ~= nil and p:IsDescendantOf(workspace)
end

local function trackFiredPrompt(p)
    for pp in pairs(firedPrompts) do
        if not promptPresent(pp) then firedPrompts[pp] = nil end
    end
    if p then firedPrompts[p] = true end
end

local function untrackFiredPrompt(p)
    if p then firedPrompts[p] = nil end
end

local function firedPromptsRemaining()
    local n = 0
    for pp in pairs(firedPrompts) do
        if promptPresent(pp) then n = n + 1 else firedPrompts[pp] = nil end
    end
    return n
end

local cooldown = {}

local function matchesWhitelist(rarity, name)
    local rOK = (#st.tameRarities == 0) or (table.find(st.tameRarities, rarity) ~= nil)
    local nOK = (#st.tameNames == 0) or (table.find(st.tameNames, name) ~= nil)
    return rOK and nOK
end

local function refFor(visual)
    local rf = mapFolder("WildPetRef")
    if not rf then return nil end
    local refName = visual.Name:match("(WildPet_[%x%-]+)$")
    return refName and rf:FindFirstChild(refName) or nil
end

local function refCFrame(ref)
    if ref:IsA("BasePart") then return ref.CFrame end
    local p = ref.PrimaryPart or ref:FindFirstChildWhichIsA("BasePart")
    if p then return p.CFrame end
    if ref:IsA("Model") then return ref:GetPivot() end
    return nil
end

local PROTECT_RADIUS = 20
local shovelHitCd = {}

local function findShovel()
    for _, cont in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
        if cont then
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") and (t:GetAttribute("Shovel") ~= nil or t.Name == "Shovel") then return t end
            end
        end
    end
    return nil
end

local function equipShovel()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local sh = findShovel()
    if sh and sh.Parent ~= char then pcall(function() hum:EquipTool(sh) end) end
end

local function protectAura()
    local root = hrp()
    if not root then return end
    local now = os.clock()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local tr = pl.Character:FindFirstChild("HumanoidRootPart")
            if tr and (tr.Position - root.Position).Magnitude <= PROTECT_RADIUS then
                if not shovelHitCd[pl] or now - shovelHitCd[pl] > 0.5 then
                    shovelHitCd[pl] = now
                    pcall(function() Networking.Shovel.HitPlayer:Fire(pl.UserId) end)
                end
            end
        end
    end
end

local function tamePet(visual, ref, fromAuto)
    local rp = visual:FindFirstChild("RootPart")
    local prompt = rp and rp:FindFirstChild("BuyPrompt")
    local root = hrp()
    if not (rp and prompt and root) then return false end
    local returnCF = root.CFrame
    if st.protectWildTame then equipShovel() end
    local start = os.clock()
    local lastFire = 0
    local lastT = os.clock()
    local lastAura = 0
    local ok = false
    while os.clock() - start < (st.protectWildTame and 30 or 15) do
        if fromAuto and not st.autoTame then break end
        local petGone = not (visual.Parent and ref.Parent)
        if st.protectWildTame then
            if petGone then
                ok = true
                break
            end
            if os.clock() - lastAura > 0.3 then
                lastAura = os.clock()
                equipShovel()
                protectAura()
            end
        else
            if tamedThis(ref, start) then
                ok = true
                break
            end
            if petGone then
                local g = os.clock()
                while os.clock() - g < 3 do
                    if tamedThis(ref, start) then
                        ok = true
                        break
                    end
                    task.wait(0.1)
                end
                break
            end
            local owner = tonumber(ref:GetAttribute("OwnerUserId")) or 0
            if owner ~= 0 and owner ~= LocalPlayer.UserId then break end
            local cap = tonumber(st.maxPetPrice) or 0
            if cap > 0 and (tonumber(ref:GetAttribute("Price")) or 0) > cap then break end
        end
        local now = os.clock()
        local dt = math.min(now - lastT, 0.1)
        lastT = now
        local goal = (refCFrame(ref) or rp.CFrame).Position
        local cur = root.Position
        local to = goal - cur
        local dist = to.Magnitude
        if st.protectWildTame then
            if dist > 4 then
                local step = math.min(60 * dt, dist - 3)
                local newPos = cur + to.Unit * step
                root.CFrame = CFrame.lookAt(newPos, Vector3.new(goal.X, newPos.Y, goal.Z))
            else
                root.CFrame = CFrame.lookAt(cur, Vector3.new(goal.X, cur.Y, goal.Z))
            end
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        else
            local speed = math.clamp(tonumber(st.tameMoveSpeed) or 16, 4, 50)
            if dist > 5 then
                local step = math.min(speed * dt, dist - 4)
                local nextPos = cur + to.Unit * step
                root.CFrame = CFrame.lookAt(nextPos, Vector3.new(goal.X, nextPos.Y, goal.Z))
                pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
            end
        end
        if dist <= 12 and now - lastFire > 0.4 then
            markTameFired(ref)
            trackFiredPrompt(prompt)
            if type(fireproximityprompt) == "function" then
                pcall(function() fireproximityprompt(prompt) end)
            else
                pcall(function() Networking.Pets.WildPetTame:Fire(ref) end)
            end
            lastFire = now
        end
        RunService.Heartbeat:Wait()
    end
    clearTamePending(ref)
    if not ok then untrackFiredPrompt(prompt) end
    if st.tameReturnAfter then pcall(function() root.CFrame = returnCF end) end
    return ok
end

local function pickTarget()
    local spawns = mapFolder("WildPetSpawns")
    local root = hrp()
    if not (spawns and root) then return nil end
    local best, bestRef, bestDist
    local now = os.clock()
    for _, visual in ipairs(spawns:GetChildren()) do
        local rp = visual:FindFirstChild("RootPart")
        local ref = refFor(visual)
        local cd = cooldown[visual]
        if rp and typeof(ref) == "Instance" and (not cd or cd < now) and tonumber(ref:GetAttribute("OwnerUserId")) == 0 then
            local rarity = tostring(ref:GetAttribute("Rarity"))
            local pname = tostring(ref:GetAttribute("PetName"))
            local price = tonumber(ref:GetAttribute("Price")) or 0
            local cap = tonumber(st.maxPetPrice) or 0
            if matchesWhitelist(rarity, pname) and Sheckles.Value >= price and (cap <= 0 or price <= cap) then
                local d = (rp.Position - root.Position).Magnitude
                if not bestDist or d < bestDist then best, bestRef, bestDist = visual, ref, d end
            end
        end
    end
    return best, bestRef
end

local function fastTame(visual, ref)
    local rp = visual:FindFirstChild("RootPart")
    local prompt = rp and rp:FindFirstChild("BuyPrompt")
    local root = hrp()
    if not (rp and prompt and root) then return false end
    local start = os.clock()
    local lastT = os.clock()
    local settledAt = nil
    local firedOnce = false
    local lastFire = 0
    local ok = false
    while true do
        if not st.autoTame then break end
        if tamedThis(ref, start) then ok = true break end
        local petGone = not (visual.Parent and ref.Parent)
        if petGone then
            if firedOnce then
                local g = os.clock()
                while os.clock() - g < 1.5 do
                    if tamedThis(ref, start) then break end
                    task.wait(0.1)
                end
                ok = true
            end
            break
        end
        local owner = tonumber(ref:GetAttribute("OwnerUserId")) or 0
        if owner ~= 0 and owner ~= LocalPlayer.UserId then break end
        local cap = tonumber(st.maxPetPrice) or 0
        if cap > 0 and (tonumber(ref:GetAttribute("Price")) or 0) > cap then break end
        if not firedOnce and os.clock() - start > 8 then break end
        if firedOnce and os.clock() - start > 20 then break end
        local now = os.clock()
        local dt = math.min(now - lastT, 0.1)
        lastT = now
        local goal = (refCFrame(ref) or rp.CFrame).Position
        local cur = root.Position
        local to = goal - cur
        local dist = to.Magnitude
        local speed = math.clamp(tonumber(st.tameMoveSpeed) or 16, 4, 50)
        if dist > 6 then
            settledAt = nil
            local step = math.min(speed * dt, dist - 5)
            local nextPos = cur + to.Unit * step
            root.CFrame = CFrame.lookAt(nextPos, Vector3.new(goal.X, nextPos.Y, goal.Z))
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        else
            root.CFrame = CFrame.lookAt(cur, Vector3.new(goal.X, cur.Y, goal.Z))
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
            settledAt = settledAt or now
            if now - settledAt > 0.6 and now - lastFire > 0.4 then
                lastFire = now
                firedOnce = true
                markTameFired(ref)
                trackFiredPrompt(prompt)
                if type(fireproximityprompt) == "function" then
                    pcall(function() fireproximityprompt(prompt) end)
                else
                    pcall(function() Networking.Pets.WildPetTame:Fire(ref) end)
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
    clearTamePending(ref)
    if not ok then untrackFiredPrompt(prompt) end
    return ok
end

local function doTameStep(target, ref)
    if st.protectWildTame then
        local name = tostring(ref:GetAttribute("PetName"))
        local price = tonumber(ref:GetAttribute("Price")) or 0
        if tamePet(target, ref, true) then
            notify(("Tamed %s (-%s)"):format(name, tostring(price)))
        else
            cooldown[target] = os.clock() + 12
        end
    else
        fastTame(target, ref)
        cooldown[target] = os.clock() + 2
    end
end

