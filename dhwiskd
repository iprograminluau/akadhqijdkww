-- ── VM centre-click loop ─────────────────────────────────────────────────────
-- Clicks the middle of the screen every vmClickDelay seconds, starting the moment the
-- script executes and never stopping. Purely additive to skipLoadingScreen below: on
-- executors where VirtualInputManager works this alone dismisses "Click to skip!", and
-- where VIM is a no-op it costs nothing.
task.spawn(function()
    while true do
        if st.vmClick then
            pcall(function()
                local cam = workspace.CurrentCamera
                local vp = cam and cam.ViewportSize
                local w, h = 400, 400
                if vp and vp.X > 4 then w, h = vp.X, vp.Y end
                local cx, cy = math.floor(w / 2), math.floor(h / 2)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                pcall(function()
                    VirtualInputManager:SendTouchEvent(1, 0, cx, cy)
                    VirtualInputManager:SendTouchEvent(1, 2, cx, cy)
                end)
            end)
        end
        task.wait(math.max(1, tonumber(st.vmClickDelay) or 8))
    end
end)

-- Character-load watchdog. If we're in the gameplay phase yet have no HumanoidRootPart
-- for charLoadTimeout seconds straight, rejoin a fresh server.
do
    local function inGameplayPhase()
        if LocalPlayer:GetAttribute("LoadingScreenDone") ~= true then return false end
        if LocalPlayer:GetAttribute("OfflineCutscenePlaying") == true then return false end
        if LocalPlayer:GetAttribute("CutsceneInputBlocked") == true then return false end
        if workspace:FindFirstChild("LoadingScreenMenu") then return false end
        return true
    end

    task.spawn(function()
        local missingSince = nil
        local busy = false
        while true do
            task.wait(0.5)
            local timeout = tonumber(st.charLoadTimeout) or 0
            if timeout <= 0 or busy or hrp() then
                missingSince = nil
            else
                missingSince = missingSince or os.clock()
                local waited = os.clock() - missingSince
                local limit = inGameplayPhase() and timeout or math.max(timeout, 45)
                if waited >= limit then
                    busy = true
                    notify(("No character for %ds -- rejoining..."):format(math.floor(waited)))
                    for _ = 1, 6 do
                        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                        task.wait(1.5)
                    end
                    busy = false
                    missingSince = nil
                end
            end
        end
    end)
end

