-- ---------- WisHUB Pet Finder (targeted hop) ----------
-- Endpoint returns a flat array, one row per (pet, server):
-- {pet_name, rarity, job_id, players, max_players, expires_at(unix), ...}
local PetRarityByName = {
    Bunny = "Common", Frog = "Common",
    Owl = "Uncommon",
    Deer = "Rare",
    Bee = "Legendary", Robin = "Legendary", Dragonfly = "Legendary", Wolf = "Legendary",
    Fox = "Mythic", Turkey = "Mythic", Squirrel = "Mythic", Bear = "Mythic",
    GoldenDragonfly = "Mythic", Monkey = "Mythic", Unicorn = "Mythic", Dog = "Mythic",
    ShadowDragon = "Super", Swan = "Super", BlackDragon = "Super", IceSerpent = "Super", Raccoon = "Super",
}
local FINDER_BASE = "https://gag2petfinder.wishub.cloud/api/wq7x2k9p"
local FINDER_MIN_REMAINING = 20
local finderFailedJobs = {}

local function finderRequestFn()
    return (WIS_Request and WIS_Request.request) or (syn and syn.request)
        or (fluxus and fluxus.request) or (http and http.request) or http_request or request
end

-- Pick ONE random rarity per fetch (Common .. Super). Each bot therefore asks a
-- different question every hop, so a co-launched fleet spreads instead of all
-- stacking onto the same "best" server. finderRarities still narrows the pool.
local function finderPetNames()
    local pool = {}
    local want = st.finderRarities
    if type(want) == "table" and #want > 0 then
        for _, r in ipairs(want) do pool[#pool + 1] = r end
    else
        local seen = {}
        for _, rarity in pairs(PetRarityByName) do
            if not seen[rarity] then
                seen[rarity] = true
                pool[#pool + 1] = rarity
            end
        end
    end

    if st.finderRandomRarity and #pool > 0 then
        local pick = pool[math.random(1, #pool)]
        local names = {}
        for name, rarity in pairs(PetRarityByName) do
            if rarity == pick then names[#names + 1] = name end
        end
        if #names > 0 then return names, pick end
    end

    local restrict = type(want) == "table" and #want > 0
    local names = {}
    for name, rarity in pairs(PetRarityByName) do
        if not restrict or table.find(want, rarity) then
            names[#names + 1] = name
        end
    end
    return names, nil
end

local function finderFetch()
    if not st.useFinder then return nil end
    local req = finderRequestFn()
    if type(req) ~= "function" then return nil end
    local names, pickedRarity = finderPetNames()
    if #names == 0 then return nil end
    local url = FINDER_BASE .. "?pet_name=" .. table.concat(names, ",")
    local resp
    local ok = pcall(function()
        resp = req({
            Url = url,
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. tostring(st.finderToken or ""),
                ["Cache-Control"] = "no-store",
                ["Pragma"] = "no-cache",
            },
        })
    end)
    if not ok or not resp then return nil end
    local body = resp.Body or resp.body
    if type(body) ~= "string" then return nil end
    local decoded
    if not pcall(function() decoded = HttpService:JSONDecode(body) end) then return nil end
    if type(decoded) ~= "table" then return nil end
    return decoded, pickedRarity
end

-- Return up to `count` job_ids: newest reports first (largest time left = the report
-- the finder just wrote), trimmed to finderFreshTop, then shuffled. One HTTP call.
local function finderPickJobs(count)
    count = math.max(1, math.floor(tonumber(count) or 1))
    local pets, pickedRarity = finderFetch()
    if not pets then return {} end
    local cur = normJob(game.JobId)
    local now = os.time()
    local clock = os.clock()

    local best = {}
    for _, p in ipairs(pets) do
        local job = tostring(p.job_id or "")
        local remain = (tonumber(p.expires_at) and (p.expires_at - now)) or tonumber(p.remaining) or 0
        local players = tonumber(p.players) or 0
        local maxp = tonumber(p.max_players) or 8
        local failed = finderFailedJobs[job]
        if job ~= "" and normJob(job) ~= cur and remain >= FINDER_MIN_REMAINING and players < maxp
            and not (failed and failed > clock) then
            local prev = best[job]
            if not prev or remain > prev.remain then
                best[job] = { players = players, remain = remain }
            end
        end
    end

    local function collect(allowRecent)
        local arr = {}
        for job, info in pairs(best) do
            if allowRecent or not wasRecent(job) then
                arr[#arr + 1] = { job = job, remain = info.remain }
            end
        end
        return arr
    end

    local arr = collect(false)
    if #arr == 0 then arr = collect(true) end
    if #arr == 0 then return {} end

    table.sort(arr, function(a, b) return a.remain > b.remain end)

    local topN = math.max(1, math.floor(tonumber(st.finderFreshTop) or 50))
    if #arr > topN then
        for i = #arr, topN + 1, -1 do arr[i] = nil end
    end

    for i = #arr, 2, -1 do
        local j = math.random(1, i)
        arr[i], arr[j] = arr[j], arr[i]
    end

    local out = {}
    for i = 1, math.min(count, #arr) do out[#out + 1] = arr[i].job end
    if pickedRarity then
        notify(("Finder: %s -> %d fresh servers"):format(pickedRarity, #out))
    end
    return out
end

local function fetchHopServers(allowRecent)
    local pid = game.PlaceId
    local list = {}
    local cursor = ""
    local cur = normJob(game.JobId)
    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. pid .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok then break end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not (ok2 and type(data) == "table" and type(data.data) == "table") then break end
        for _, s in ipairs(data.data) do
            if normJob(s.id) ~= cur and type(s.playing) == "number" and type(s.maxPlayers) == "number"
                and s.playing < s.maxPlayers
                and (allowRecent or not wasRecent(s.id)) then
                list[#list + 1] = { id = s.id, playing = s.playing }
            end
        end
        cursor = tostring(data.nextPageCursor or "")
        if cursor == "" then break end
    end
    table.sort(list, function(a, b) return a.playing < b.playing end)
    return list
end

-- Build the hop queue: finder and public interleaved 2:1 (F F P F F P ...) so a dead
-- finder entry is followed quickly by a plain public server instead of 10 more finder
-- entries from the same possibly-stale batch.
local function buildJobList()
    local jobs, seen = {}, {}
    local function add(j)
        j = tostring(j or "")
        if j ~= "" and not seen[normJob(j)] then
            seen[normJob(j)] = true
            jobs[#jobs + 1] = j
        end
    end

    local finderJobs = {}
    local usePublic = math.random() < (tonumber(st.finderPublicMix) or 0)
    if st.useFinder and not usePublic then
        local want = math.max(0, math.floor(tonumber(st.finderCandidates) or 10))
        if want > 0 then finderJobs = finderPickJobs(want) end
    end

    local publicJobs = {}
    local pubWant = math.max(0, math.floor(tonumber(st.publicCandidates) or 3))
    if pubWant > 0 then
        local servers = fetchHopServers(false)
        if #servers == 0 then servers = fetchHopServers(true) end
        for i = 1, math.min(#servers, pubWant) do
            publicJobs[#publicJobs + 1] = servers[i].id
        end
    end

    local fi, pi = 1, 1
    while fi <= #finderJobs or pi <= #publicJobs do
        for _ = 1, 2 do
            if fi <= #finderJobs then
                add(finderJobs[fi])
                fi = fi + 1
            end
        end
        if pi <= #publicJobs then
            add(publicJobs[pi])
            pi = pi + 1
        end
    end

    return jobs
end

-- Hop by walking the candidate queue: teleport to a job, wait a short window, and on a
-- failure (server gone / full / private) move to the NEXT job instead of re-firing the
-- same dead one. On success the client leaves and this thread dies mid-loop.
local function serverHop()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) == "function" then pcall(q, "getgenv().WisHubGaG2TameResume = true") end
    local pid = game.PlaceId
    local round = 0
    while st.autoTame and st.autoHop do
        round = round + 1
        local jobs = buildJobList()
        if #jobs == 0 then
            notify(("No fresh server found, retrying (#%d)"):format(round))
            task.wait(2)
            continue
        end

        for idx, job in ipairs(jobs) do
            if not (st.autoTame and st.autoHop) then return false end
            dismissTeleportError()
            teleportFailed = false
            teleportFailResult = nil
            markVisited(job)
            pcall(function() TeleportService:TeleportToPlaceInstance(pid, job, LocalPlayer) end)

            local t0 = os.clock()
            while not teleportFailed and os.clock() - t0 < 12 do
                if not (st.autoTame and st.autoHop) then return false end
                task.wait(0.25)
            end

            if teleportFailed then
                local flooded = teleportFailResult == Enum.TeleportResult.Flooded
                local unauth = teleportFailResult == Enum.TeleportResult.Unauthorized
                finderFailedJobs[job] = os.clock() + (unauth and 36000 or 45)
                if flooded then
                    notify(("Rate-limited, waiting (round %d)"):format(round))
                    task.wait(12)
                else
                    notify(("Server dead/full, next candidate (%d/%d)"):format(idx, #jobs))
                end
            else
                notify(("Teleport stuck, next candidate (%d/%d)"):format(idx, #jobs))
            end
        end
        task.wait(1)
    end
    return false
end

local function instantRejoin(reason)
    reportError("Stuck (" .. tostring(reason) .. ") -- instant rejoin")
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) == "function" then pcall(q, "getgenv().WisHubGaG2TameResume = true") end
    for _ = 1, 6 do
        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        task.wait(1.5)
    end
end

