-- Skip the join loading screen, fastest-first:
--   1. fastTeardown via getgc -- the controller's own instant-teardown local.
--   2. fire the controller's InputBegan skip listener.
--   3. VirtualInputManager key/click.
--   4. force CameraType=Custom + Humanoid subject as a final guarantee.
local function skipLoadingScreen()
    local menu = workspace:FindFirstChild("LoadingScreenMenu") or workspace:WaitForChild("LoadingScreenMenu", 20)
    if not menu then return end

    local gui     = menu:FindFirstChild("LoadingGui") or menu:WaitForChild("LoadingGui", 15)
    local inner   = gui and (gui:FindFirstChild("Variant1Frame") or gui:WaitForChild("Variant1Frame", 15))
    inner = inner and (inner:FindFirstChild("InnerFrame") or inner:WaitForChild("InnerFrame", 15))
    local counter = inner and inner:FindFirstChild("CounterTxt")
    local skip    = inner and inner:FindFirstChild("SkipTxt")

    local function loadingGone()
        return (not workspace:FindFirstChild("LoadingScreenMenu"))
            or LocalPlayer:GetAttribute("LoadingScreenDone") == true
    end

    local function skippableNow()
        if counter and string.find(counter.Text, "Fully Loaded", 1, true) then return true end
        if skip and string.find(skip.Text, "Click to skip", 1, true) and skip.TextTransparency < 1 then
            return true
        end
        return false
    end

    local function ensureHumanoidCamera()
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam.CameraType ~= Enum.CameraType.Custom then
                cam.CameraType = Enum.CameraType.Custom
            end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
        end)
    end

    local function findFastTeardown()
        if type(getgc) ~= "function" or type(debug) ~= "table" or type(debug.getupvalues) ~= "function" then
            return nil
        end
        local found = nil
        pcall(function()
            for _, fn in ipairs(getgc(true)) do
                if type(fn) == "function" then
                    local oks, src = pcall(debug.info, fn, "s")
                    if oks and type(src) == "string" and string.find(src, "Loading") then
                        local oku, ups = pcall(debug.getupvalues, fn)
                        if oku and type(ups) == "table" then
                            local total, nFuncs, hasPlayer, hasMenu = 0, 0, false, false
                            for _, v in pairs(ups) do
                                total = total + 1
                                local tv = typeof(v)
                                if tv == "function" then nFuncs = nFuncs + 1 end
                                if tv == "Instance" then
                                    if v == LocalPlayer then hasPlayer = true end
                                    if v.Name == "LoadingScreenMenu" or v.Name == "LoadingGui" then hasMenu = true end
                                end
                            end
                            if total >= 12 and total <= 26 and nFuncs == 1 and hasPlayer and hasMenu then
                                found = fn
                                break
                            end
                        end
                    end
                end
            end
        end)
        return found
    end

    local function tryFastTeardown()
        local fn = findFastTeardown()
        if not fn then return false end
        pcall(fn)
        for _ = 1, 12 do
            if loadingGone() then return true end
            task.wait(0.05)
        end
        return loadingGone()
    end

    local function tryFireSkip()
        if type(getconnections) ~= "function" then return false end
        local matched, fallback = {}, {}
        local ok = pcall(function()
            for _, c in ipairs(getconnections(UserInputService.InputBegan)) do
                local f = c.Function
                if f and type(c.Fire) == "function" then
                    local oks, src = pcall(debug.info, f, "s")
                    if oks and type(src) == "string" and string.find(src, "LoadingScreen") then
                        matched[#matched + 1] = c
                    elseif type(debug) == "table" and type(debug.getupvalues) == "function" then
                        local oku, ups = pcall(debug.getupvalues, f)
                        if oku and type(ups) == "table" then
                            local total, allBool = 0, true
                            for _, v in pairs(ups) do
                                total = total + 1
                                if type(v) ~= "boolean" then allBool = false end
                            end
                            if total == 2 and allBool then fallback[#fallback + 1] = c end
                        end
                    end
                end
            end
        end)
        if not ok then return false end
        local list = (#matched > 0) and matched or fallback
        for _, c in ipairs(list) do pcall(function() c:Fire() end) end
        return #list > 0
    end

    local function vimSkip()
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.03)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        pcall(function()
            local vp = workspace.CurrentCamera.ViewportSize
            VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
        end)
    end

    local function mark(via) _G.__WISHUB_SKIP = via end

    local w = 0
    while not loadingGone()
        and (not game:IsLoaded()
            or not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")))
        and w < 60 do
        task.wait(0.2); w = w + 0.2
    end
    if loadingGone() then mark("0:already-gone"); ensureHumanoidCamera(); return end

    local lastMethod = nil
    local tries = 0
    while not loadingGone() and tries < 80 do
        if tryFastTeardown() then
            lastMethod = "1:fastTeardown"
        elseif skippableNow() and tryFireSkip() then
            lastMethod = "2:fireListener"
        else
            vimSkip()
            lastMethod = "3:vim"
        end
        tries = tries + 1
        task.wait(0.2)
    end

    mark(lastMethod or "none")
    ensureHumanoidCamera()
end

