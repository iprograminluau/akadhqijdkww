    end
    if fpsPlatform then keep[fpsPlatform] = true end
    return keep
end

-- Anything named WildPet* (or holding a WildPet* folder) is off limits: the keep-set is
-- a snapshot and the folders may not exist yet on the first pass.
local function isPetRelated(inst)
    if not inst then return false end
    if tostring(inst.Name):find("WildPet", 1, true) then return true end
    local ok, found = pcall(function()
        return inst:FindFirstChild("WildPetSpawns", true)
            or inst:FindFirstChild("WildPetRef", true)
    end)
    if ok and found then return true end
    return false
end

local function fpsClearWorld()
    local keep = fpsKeepSet()
    for _, c in ipairs(workspace:GetChildren()) do
        if keep[c] or c:IsA("Camera") or isPetRelated(c) then
        elseif c:IsA("Terrain") then
            pcall(function() c:Clear() end)
        elseif c.Name == "Map" or c.Name == "Baseplate" then
            for _, mc in ipairs(c:GetChildren()) do
                if not keep[mc] and not isPetRelated(mc) then
                    pcall(function() mc:Destroy() end)
                end
            end
        elseif c:IsA("BasePart") or c:IsA("Model") or c:IsA("Folder") or c:IsA("UnionOperation") or c:IsA("MeshPart") then
            pcall(function() c:Destroy() end)
        end
    end
end

local function ensureFpsPlatform()
    if not (fpsPlatform and fpsPlatform.Parent) then
        local p = Instance.new("Part")
        p.Name = "WisHubFloor"
        p.Size = Vector3.new(120, 2, 120)
        p.Anchored = true
        p.CanCollide = true
        p.Transparency = 1
        p.Parent = workspace
        fpsPlatform = p
    end
    fpsFloorY = nil
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if char and root then
        local ok, cf, size = pcall(function() return char:GetBoundingBox() end)
        if ok and cf and size then fpsFeetOffset = root.Position.Y - (cf.Position.Y - size.Y / 2) end
        fpsFloorY = root.Position.Y - fpsFeetOffset
        fpsPlatform.Position = Vector3.new(root.Position.X, fpsFloorY - (fpsPlatform.Size.Y / 2), root.Position.Z)
    end
    if fpsPlatformConn then fpsPlatformConn:Disconnect() end
    fpsPlatformConn = RunService.Heartbeat:Connect(function()
        if not st.fpsBoost then return end
        local r = hrp()
        if not (r and fpsPlatform and fpsPlatform.Parent) then return end
        local feetY = r.Position.Y - fpsFeetOffset
        if fpsFloorY == nil or feetY < fpsFloorY - 0.5 then fpsFloorY = feetY end
        fpsPlatform.Position = Vector3.new(r.Position.X, fpsFloorY - (fpsPlatform.Size.Y / 2), r.Position.Z)
    end)
end

local function fpsSafeToStart()
    if LocalPlayer:GetAttribute("LoadingScreenDone") ~= true then return false end
    if LocalPlayer:GetAttribute("OfflineCutscenePlaying") == true then return false end
    if LocalPlayer:GetAttribute("CutsceneInputBlocked") == true then return false end
    if workspace:FindFirstChild("LoadingScreenMenu") then return false end
    return hrp() ~= nil
end

-- EARLY-PHASE clear, safe while still loading: only strips the CONTENTS of each plot
-- (Plants + Fruits). The plot models themselves stay, so GardenSyncController still
-- finds your plot and the game does not throw the "save data didn't load right" kick.
local function fpsClearFruitTrees()
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return end
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                pcall(function() plant:Destroy() end)
            end
        end
        local fruits = plot:FindFirstChild("Fruits")
        if fruits then
            for _, f in ipairs(fruits:GetChildren()) do
                pcall(function() f:Destroy() end)
            end
        end
    end
end

local fpsGameplayActive = false

local function getParentType(desc)
    local current = desc
    local isFruit, isPlant = false, false
    while current and current ~= workspace do
        if current.Name == "Fruits" then isFruit = true end
        if current.Name == "Plants" then isPlant = true end
        current = current.Parent
    end
    return isFruit, isPlant
end

local function fpsProtected(desc)
    if fpsPlatform and (desc == fpsPlatform or desc:IsDescendantOf(fpsPlatform)) then return true end
    local char = LocalPlayer.Character
    if char and desc:IsDescendantOf(char) then return true end

    if tostring(desc.Name):find("WildPet", 1, true) then return true end
    local okA, anc = pcall(function()
        return desc:FindFirstAncestor("WildPetSpawns") or desc:FindFirstAncestor("WildPetRef")
    end)
    if okA and anc then return true end
    local cur = desc.Parent
    for _ = 1, 6 do
        if not cur or cur == workspace then break end
        if tostring(cur.Name):find("WildPet", 1, true) then return true end
        cur = cur.Parent
    end

    local m = workspace:FindFirstChild("Map")
    if m then
        local sp = m:FindFirstChild("WildPetSpawns")
        local rfr = m:FindFirstChild("WildPetRef")
        if sp and desc:IsDescendantOf(sp) then return true end
        if rfr and desc:IsDescendantOf(rfr) then return true end
    end
    return false
end

local function superBrutalize(desc)
    if fpsProtected(desc) then return end
    if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Fire")
        or desc:IsA("Smoke") or desc:IsA("Sparkles") or desc:IsA("Light") or desc:IsA("PostEffect")
        or desc:IsA("Texture") or desc:IsA("Decal") or desc:IsA("SurfaceAppearance")
        or desc:IsA("Attachment") or desc:IsA("SpecialMesh") or desc:IsA("Motor6D")
        or desc:IsA("Animator") or desc:IsA("AnimationController") then
        pcall(function() desc:Destroy() end)
        return
    end
    local n = string.lower(desc.Name)
    if n:match("track") or n:match("trace") or n:match("arrow") or n:match("guide")
        or n:match("pointer") or n:match("waypoint") or n:match("highlight") then
        pcall(function() desc:Destroy() end)
        return
    end
    if desc:IsA("PVAdornment") or desc:IsA("HandleAdornment") or desc:IsA("SurfaceGui") then
        pcall(function() desc:Destroy() end)
        return
    end
    if desc:IsA("BillboardGui") and desc.Name ~= "FruitESP" then
        pcall(function() desc:Destroy() end)
        return
    end
    if desc:IsA("BasePart") then
        local parentModel = desc:FindFirstAncestorWhichIsA("Model")
        if parentModel and string.lower(parentModel.Name):match("sprinkler") then
            if desc.Size.X > 5 or desc.Size.Z > 5 then pcall(function() desc:Destroy() end) return end
            if desc.Transparency > 0 then pcall(function() desc:Destroy() end) return end
        end
        if n:match("range") or n:match("radius") or n:match("area") or n:match("ring")
            or n:match("effect") or n:match("zone") or n:match("indicator") or n:match("visual") then
            pcall(function() desc:Destroy() end)
            return
        end
        desc.CastShadow = false
        local isFruit, isPlant = getParentType(desc)
        if desc.Name == "HarvestPart" then
            desc.Transparency = 1
        elseif isFruit then
            desc.Transparency = 1
            desc.CanCollide = false
            if desc:IsA("MeshPart") then pcall(function() desc.TextureID = "" end) end
            desc.Material = Enum.Material.SmoothPlastic
            desc.Reflectance = 0
        elseif isPlant then
            if desc.Name ~= "Base" then
                desc.Transparency = 1
                desc.CanCollide = false
            end
            desc.Anchored = true
        else
            desc.Material = Enum.Material.SmoothPlastic
            desc.Reflectance = 0
        end
    end
end

local function nukeEnvironment()
    for _, name in ipairs({ "BirdVisuals", "Birds", "BlizzardBeams", "Weather", "Clouds", "Rain" }) do
        local obj = workspace:FindFirstChild(name)
        if obj then pcall(function() obj:Destroy() end) end
    end
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        pcall(function()
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
            terrain.Decoration = false
        end)
    end
end

local function optimizeWorld()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 0
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("BloomEffect") or child:IsA("BlurEffect") or child:IsA("ColorCorrectionEffect")
                or child:IsA("SunRaysEffect") or child:IsA("DepthOfFieldEffect")
                or child:IsA("Atmosphere") or child:IsA("Sky") then
                child:Destroy()
            end
        end
    end)
    nukeEnvironment()
    for _, desc in ipairs(workspace:GetDescendants()) do
        pcall(superBrutalize, desc)
    end
end

workspace.DescendantAdded:Connect(function(desc)
    if not (st.fpsBoost and fpsGameplayActive) then return end
    local char = LocalPlayer.Character
    if char and desc:IsDescendantOf(char) then return end
    task.defer(function()
        if st.fpsBoost and fpsGameplayActive and desc and desc.Parent then
            pcall(superBrutalize, desc)
        end
    end)
end)

local function startFpsBoost()
    fpsLoopId = fpsLoopId + 1
    local id = fpsLoopId
    task.spawn(function()
        while st.fpsBoost and fpsLoopId == id and not fpsSafeToStart() do
            pcall(fpsClearFruitTrees)
            task.wait(1)
        end
        if not (st.fpsBoost and fpsLoopId == id) then return end
        fpsGameplayActive = true
        ensureFpsPlatform()
        pcall(fpsClearWorld)
        pcall(optimizeWorld)
        while st.fpsBoost and fpsLoopId == id do
            task.wait(2)
            pcall(fpsClearFruitTrees)
            if st.fpsBoost and fpsSafeToStart() then pcall(fpsClearWorld) end
        end
        fpsGameplayActive = false
    end)
end

